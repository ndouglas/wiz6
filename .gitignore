# Project layout
/extracted/*
!/extracted/font-sheets/
/.superpowers/

# Build artifacts
node_modules/
dist/
build/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/

# Original Wizardry VI DOS files now live in /original/ (ignored above).

# Parity tools local node_modules (from standalone npm install for vitest)
tools/parity/node_modules/

# DOSBox-X trace conf (contains absolute paths specific to one machine);
# captures (PNG screenshots from interactive runs) are kept as evidence of the
# Stage 1f.2 palette discovery.
/dosbox-trace/wiz6.conf

# DOSBox-X session output (transient)
tools/dosbox/dosbox.log

# Wiz6 savegames + modified scenario.hdr from user playthroughs
original/SAVEGAME.DBS

# Ghidra projects — regenerated by tools/ghidra/setup.sh (~2min runtime).
# Match Ghidra artifacts anywhere: headless runs sometimes create projects in a
# subdir (tools/ghidra/wiz6/) or even outside tools/ghidra/ entirely.
*.gpr
*.rep/
*.lock~
tools/ghidra/wiz6.lock*
tools/ghidra/wiz6/

# DOSBox-X save states (user playthrough artifacts)
tools/dosbox/save/

# DOSBox-X capture dir (transient screenshots/WAVs from interactive/dev runs)
tools/dosbox/capture/

# Playwright e2e artifacts (reports, test results, captured PNGs)
packages/viewer/playwright-report/
packages/viewer/test-results/
packages/viewer/e2e/**/*.png

tools/dosbox/dosbox-autodrive.log

# Worktrees
.claude/worktrees/
