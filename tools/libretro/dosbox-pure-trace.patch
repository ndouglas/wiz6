 MIXER_CallBack(void * /*userdata*/, uint8_t *stream, int len) {
+	/* Guard the empty-buffer case: len==0 -> need==0 -> `index_add % need` below is
+	 * modulo-by-zero (undefined behavior). clang -O2 on arm64 exploits that UB into
+	 * an out-of-bounds store that SIGSEGVs during boot (the libretro buildbot's
+	 * toolchain happened not to). Returning early on an empty buffer is harmless and
+	 * fixes it at the root. */
+	if (len <= 0) return;
 	Bitu need=(Bitu)len/MIXER_SSIZE;
 	Bit16s * output=(Bit16s *)stream;
 	Bitu reduce;
