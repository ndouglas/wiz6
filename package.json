{
  "name": "wiz6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm -r --filter './packages/*' test",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:viewer": "pnpm --filter @wiz6/viewer dev",
    "extract": "pnpm extract:fonts && pnpm extract:portraits && pnpm extract:screens && pnpm extract:messages && pnpm extract:newgame && pnpm extract:scenario",
    "extract:fonts": "tsx packages/parser/src/cli.ts extract-fonts ./original ./extracted",
    "extract:portraits": "tsx packages/parser/src/cli.ts extract-portraits ./original ./extracted",
    "extract:screens": "tsx packages/parser/src/cli.ts extract-screens ./original ./extracted",
    "extract:messages": "tsx packages/parser/src/cli.ts extract-messages ./original ./extracted",
    "extract:newgame": "tsx packages/parser/src/cli.ts extract-newgame ./original ./extracted",
    "extract:scenario": "tsx packages/parser/src/cli.ts extract-scenario ./original ./extracted"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}
