{
  "name": "wiz6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "pnpm -r --filter './packages/*' test && pnpm test:parity",
    "test:parity": "pnpm --filter @wiz6/parity test",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:viewer": "pnpm --filter @wiz6/viewer dev",
    "wiz6": "tsx packages/cli/src/bin/wiz6.ts",
    "extract": "pnpm wiz6 extract --all"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  }
}
